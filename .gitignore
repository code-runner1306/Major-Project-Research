# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
# Large model weights and binary files (exceed GitHub size limits)
*.pt
*.ckpt
*.bin
*.safetensors
*.arrow
*.parquet
*.tar.gz
*.zip
output/**/*.pt

# Only the four published development checkpoints may be committed.
/published_mqar/**/latest_checkpoint/
/published_overwrite/**/latest_checkpoint/
!/published_mqar/scalar/latest_checkpoint.pt
!/published_mqar/channel-wise/latest_checkpoint.pt
!/published_overwrite/scalar/latest_checkpoint.pt
!/published_overwrite/channel_wise/latest_checkpoint.pt
# Calibrated-study runs explicitly preserve their small final checkpoints.
!/output/calibrated_recipe_study/**/latest_checkpoint.pt
!/research_results/aggregated_recipe_study/**/latest_checkpoint.pt

# Ignore heavy raw dataset cache in data/, but keep JSON split manifests tracked
data/*
!data/splits/
!data/splits/*.json
!data/**/*.json
!data/**/splits/
!data/**/splits/*.json

.agent/
.github/
.opencode/
*.pdf
.codex/
tinystories/
output/full_research/aggregate_report.json 
research_results/write_gate_mechanism_20261117/diagnostics_per_write.csv
